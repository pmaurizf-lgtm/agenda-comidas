{
  "expo": {
    "name": "food-tracker-app",
    "slug": "food-tracker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.pablomouriz.agendacomidas",
      "supportsTablet": true
    },
    "android": {
      "package": "com.pablomouriz.agendacomidas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "experiments": {
      "baseUrl": "/agenda-comidas"
    },
    "extra": {
      "eas": {
        "projectId": "7a2a94f7-ae13-43e4-9676-f725cd99f33c"
      }
    },
    "owner": "pablomouriz"
  }
}
